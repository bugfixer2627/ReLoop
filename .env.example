# Copy to .env.local. All credentials remain server-side.
# Use a dedicated synthetic-demo Supabase project, not a production database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct/session-pooler Postgres URL for migrations; never exposed by the app.
DATABASE_URL=

# OpenAI-compatible chat and transcription endpoints. Keys remain server-side.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
TRANSCRIPTION_PROVIDER=openai_compatible
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Required before enabling write endpoints on a shared deployment.
# Foundation write endpoints return 501 and are not enabled by this setting alone.
DEMO_ACCESS_TOKEN=
