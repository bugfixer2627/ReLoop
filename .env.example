# Copy to .env.local. All credentials remain server-side.
# Use a dedicated synthetic-demo Supabase project, not a production database.
# Project origin only, for example https://<project-ref>.supabase.co (no /rest/v1).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct/session-pooler Postgres URL for migrations; never exposed by the app.
DATABASE_URL=
# Optional local path to the project's CA certificate from Supabase Database
# Settings. TLS verification stays enabled. Never use rejectUnauthorized=false.
DATABASE_SSL_CA_FILE=

# OpenAI-compatible chat and transcription endpoints. Keys remain server-side.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional bounded provider timeout (1000..120000 milliseconds; default 30000).
LLM_TIMEOUT_MS=60000
# Standard OpenAI key name is supported as a fallback only for api.openai.com.
# OPENAI_API_KEY=
# With OPENAI_API_KEY alone, defaults are gpt-4o-mini and whisper-1.
# Explicit LLM_*/TRANSCRIPTION_* values take precedence for custom providers.
# Organizer gateway (chat verified; audio endpoint returned 404):
# LLM_BASE_URL=https://api.tokenhubcloud.net/v1
# LLM_MODEL=gpt-5.6-luna
# LLM_API_KEY=${OPENAI_API_KEY}
# Configure a separate verified speech service below; chat model access alone
# does not establish audio/transcriptions support.
TRANSCRIPTION_PROVIDER=openai_compatible
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Required for protected case/workflow endpoints in development and deployment.
# Use a random server-side value with at least 32 characters; never expose it
# through NEXT_PUBLIC_* variables or commit it.
DEMO_ACCESS_TOKEN=
